{
  "name": "ineffable-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "check:chat-resume": "node --experimental-strip-types scripts/check-conversation-resume-state.mjs",
    "check:chat-runtime": "node --experimental-strip-types scripts/check-conversation-runtime-status.mjs",
    "check:chat-routing": "node --experimental-strip-types scripts/check-conversation-event-routing.mjs",
    "check:chat-store": "node --experimental-strip-types scripts/check-chat-runtime-store.mjs",
    "check:chat-architecture": "node --experimental-strip-types scripts/check-chat-runtime-architecture.mjs",
    "check:chat-web-runtime": "node --experimental-strip-types scripts/check-chat-web-runtime.mjs",
    "check:polling": "node --experimental-strip-types scripts/check-page-activity-policy.mjs",
    "check:auth-session": "node --experimental-strip-types scripts/check-auth-session-runtime.mjs",
    "i18n:check": "node --experimental-strip-types scripts/check-i18n-resources.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.1.17",
    "@uiw/react-codemirror": "^4.25.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^0.575.0",
    "markdown-it": "^14.1.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "shadcn": "^3.8.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0"
