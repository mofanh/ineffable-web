{
  "name": "ineffable-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "check:chat-resume": "node --experimental-strip-types scripts/check-conversation-resume-state.mjs",
    "check:chat-runtime": "node --experimental-strip-types scripts/check-conversation-runtime-status.mjs",
    "check:agent-iteration-handoff": "node --experimental-strip-types scripts/check-agent-iteration-handoff.mjs",
    "check:chat-routing": "node --experimental-strip-types scripts/check-conversation-event-routing.mjs",
    "check:input-progress": "tsx scripts/check-input-progress.mjs",
    "check:chat-store": "node --experimental-strip-types scripts/check-chat-runtime-store.mjs",
    "check:chat-architecture": "node --experimental-strip-types scripts/check-chat-runtime-architecture.mjs",
    "check:chat-web-runtime": "tsx scripts/check-chat-web-runtime.mjs && tsx scripts/check-chat-segments.mjs",
    "check:chat-web-integration": "tsx scripts/check-chat-web-integration.mjs",
    "check:model-failure": "node --experimental-strip-types scripts/check-model-failure-presentation.mjs",
    "check:capability-catalog": "tsx scripts/check-capability-catalog-selection.mjs",
    "check:admin-capability-families": "tsx scripts/check-admin-capability-family-selection.mjs",
    "check:admin-usage-timeseries": "tsx scripts/check-admin-usage-timeseries.mjs",
    "check:automation-runtime": "node scripts/check-automation-runtime-browser.mjs",
    "check:chat-browser": "node scripts/check-chat-virtualization-browser.mjs && node scripts/check-live-refresh-browser.mjs",
    "check:request-efficiency": "tsx scripts/check-request-efficiency.mjs",
    "check:request-efficiency-browser": "node scripts/check-request-efficiency-browser.mjs",
    "check:sandbox-delivery-browser": "node scripts/check-sandbox-delivery-browser.mjs",
    "check:sandbox-delivery": "node --experimental-strip-types scripts/check-sandbox-delivery.mjs",
    "check:polling": "node --experimental-strip-types scripts/check-page-activity-policy.mjs",
    "check:responsive-layout": "node --experimental-strip-types scripts/check-responsive-layout.mjs",
    "check:auth-session": "node --experimental-strip-types scripts/check-auth-session-runtime.mjs",
    "check:password-change": "node scripts/check-password-change-browser.mjs",
    "i18n:check": "node --experimental-strip-types scripts/check-i18n-resources.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:admin-mobile": "node scripts/check-admin-mobile-browser.mjs",
    "check:admin-editor": "node scripts/check-admin-editor-browser.mjs",
    "check:workspace-delete": "node scripts/check-workspace-delete-browser.mjs",
    "check:workspace-directory": "tsx scripts/check-workspace-directory.mjs",
    "check:run-observations": "node scripts/check-run-observations-browser.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-virtual": "^3.14.10",
    "@uiw/react-codemirror": "^4.25.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^0.575.0",
    "markdown-it": "^14.1.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "shadcn": "^3.8.5",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright-core": "^1.62.1",
    "react-test-renderer": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
